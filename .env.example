# =============================================================================
# FBO Manager - Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Django Backend
# -----------------------------------------------------------------------------
DEBUG=1
SECRET_KEY=your_secret_key_here

# -----------------------------------------------------------------------------
# Next.js Frontend
# -----------------------------------------------------------------------------
# API URLs
API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Push Notifications (VAPID)
# -----------------------------------------------------------------------------
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_EMAIL=your_vapid_email_here
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key_here

# -----------------------------------------------------------------------------
# QT Technologies Fuel Dispatch
# -----------------------------------------------------------------------------
QT_USERNAME=your_qt_username
QT_PASSWORD=your_qt_password
QT_COMPANY_LOCATION_ID=your_company_location_id
QT_USER_ID=your_user_id

# -----------------------------------------------------------------------------
# Supabase (direct connect + Next.js client)
# -----------------------------------------------------------------------------
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_DB_HOST=your_supabase_db_host
SUPABASE_DB_USER=your_supabase_db_user
SUPABASE_DB_PASSWORD=your_supabase_db_password
SUPABASE_DB_NAME=postgres
SUPABASE_DB_PORT=5432

# -----------------------------------------------------------------------------
# Anthropic (Claude Vision OCR — truck sheets; schedule import only as a last resort, see below)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=your_anthropic_api_key

# -----------------------------------------------------------------------------
# Schedule sheet import (/api/ocr/schedule-sheet): free OCR first
# -----------------------------------------------------------------------------
# Engine order: Tesseract (local, free, eng.traineddata bundled in frontend/ocr-data) -> Google Cloud Vision when the
# Tesseract read is poor and this key is set -> Claude vision only if SCHEDULE_OCR_ALLOW_CLAUDE=1.
# Google Cloud Vision (DOCUMENT_TEXT_DETECTION, about 1,000 free units a month). Leave empty to skip the fallback.
GOOGLE_VISION_API_KEY=
# Claude vision for sheets whose format the parser does not recognise. Costs API credit: keep off (0) by default.
SCHEDULE_OCR_ALLOW_CLAUDE=0
